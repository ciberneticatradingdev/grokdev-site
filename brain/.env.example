# Copy to Railway env or a local .env that is NEVER committed.

PORT=8969

# --- voice (existing) ---
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- agent wallet (server-side operator; public address only is exposed) ---
# Generate once: node scripts/generate-wallet.js --out ./secrets/wallet.json
# WALLET_KEYPAIR_PATH=/absolute/path/to/wallet.json
# WALLET_SECRET_KEY=          # base58 or JSON byte array — do not commit

# --- deploy gate (default: observe + dry-run, NO live creates) ---
DEPLOY_ENABLED=0
# DEPLOY_ON_WATCH=0           # even with DEPLOY_ENABLED, watched tweets do not auto-create unless 1
# DEPLOY_COOLDOWN_HOURS=24
# DEPLOY_MAX_PER_WEEK=1
# OPERATOR_SECRET=            # if set, POST /tweet and POST /deploy require header x-operator-secret

# --- pump.fun create + buy ---
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# BUY_SOL=0.01
# METADATA_URI=               # skip Pinata; pass an already-hosted metadata JSON URL
# PINATA_JWT=                 # upload image + metadata JSON to IPFS
# MAYHEM_MODE=0
# CASHBACK=0

# --- tweet ingest ---
# X_BEARER_TOKEN=             # official X API v2. without it: URL uses syndication/oembed, or paste a payload
# X_API_HOST=https://api.x.com
# X_WATCH_ACCOUNTS=           # comma-separated handles; requires X_BEARER_TOKEN
# X_POLL_MS=180000
